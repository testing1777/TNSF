PORT=8000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/tnsf_ejournal
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
PUBLIC_SITE_URL=http://localhost:5173
ADMIN_SITE_URL=http://localhost:5174
# Set to true only when the API runs behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false
ADMIN_NAME=Journal Administrator
ADMIN_EMAIL=admin@example.gov.in
ADMIN_PASSWORD=ChangeThis-Strong-Password-123!
UPLOAD_DIR=./uploads
